{
  "expo": {
    "name": "pinolrent",
    "slug": "pinolrent",
    "version": "1.0.0",
    "scheme": "pinolrent",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pinolrent.app"
    },
    "android": {
      "package": "com.pinolrent.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./src/assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1D4ED8",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b21bf93-1ceb-4fa0-a6fb-f79f9ee02895"
      }
    },
    "owner": "pinolrent"
  }
}
